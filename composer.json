{
  "authors": [
    {
      "email": "dv.vostrikov@gmail.com",
      "name": "Dmitry Vostrikov"
    }
  ],
  "autoload": {
    "psr-4": {
      "CoreX\\Modules\\": "src/"
    }
  },
  "description": "CoreX module system — EntityRegistry, module manifests, discovery and the compiled registry hot-path.",
  "extra": {
    "laravel": {
      "providers": [
        "CoreX\\Modules\\ModulesServiceProvider"
      ]
    }
  },
  "keywords": [
    "laravel",
    "modules",
    "entity-registry"
  ],
  "license": "MIT",
  "minimum-stability": "dev",
  "name": "corex/modules",
  "prefer-stable": true,
  "require": {
    "corex/core": "0.4.0-alpha.20260918",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "php": "^8.3"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "orchestra/testbench": "^10.0|^11.0",
    "phpstan/phpstan": "^2.0"
  },
  "scripts": {
    "analyse": "cd ../.. && vendor/bin/phpstan analyse -c phpstan.neon packages/modules/src packages/modules/database/migrations --memory-limit=1G",
    "lint:check": "../../vendor/bin/pint --test",
    "test": "../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=ModulesPackage",
    "test:coverage": "XDEBUG_MODE=coverage ../../vendor/bin/pest --configuration=../../phpunit.xml --bootstrap=../../vendor/autoload.php --testsuite=ModulesPackage --coverage --min=80"
  },
  "type": "library",
  "version": "0.4.0-alpha.20260918"
}
